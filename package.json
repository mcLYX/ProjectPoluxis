{
  "name": "poluxis",
  "private": true,
  "version": "0.0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lite && vite build",
    "build:lite": "node scripts/build-lite.mjs",
    "build:lite:toy": "node scripts/build-lite.mjs --no-pwa --no-server",
    "split:lite": "node scripts/split-lite.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "dev:toy": "vite --config vite.toy.config.ts --mode toy",
    "build:toy": "npm run build:lite:toy && vite build --config vite.toy.config.ts --mode toy"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/three": "^0.186.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "2.1.1",
    "fflate": "^0.8.3",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.17",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.0.0",
    "node-vibrant": "^4.0.4",
    "prettier": "^3.0.0",
    "tailwindcss": "4.3.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "esbuild": "^0.28.2"
  }
}
